<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=1440,initial-scale=1">
<title>ShotForm · 动作序列台</title>
<style>
@font-face{font-family:Harmony;src:url('{{FONT_URL}}') format('truetype');font-weight:400;font-display:block}
*{box-sizing:border-box}body{margin:0;width:1440px;height:900px;overflow:hidden;background:#0A0D12;color:#F3F0EA;font:15px/1.6 Harmony,'Microsoft YaHei UI',sans-serif}button{font:inherit;cursor:default}button:focus-visible{outline:2px solid #9fb6dc;outline-offset:4px}.shell{width:1440px;height:900px}.topnav{height:64px;display:flex;align-items:center;padding:0 34px;border-bottom:1px solid #29313B;gap:46px}.wordmark{font-size:20px;letter-spacing:-.5px;font-weight:700;display:flex;align-items:center;gap:9px}.mark{width:23px;height:23px;border:1.5px solid #C9823D;border-radius:50%;position:relative;overflow:hidden}.mark:before{content:'';position:absolute;width:9px;height:28px;border:1px solid #C9823D;border-radius:50%;top:-4px;left:5px}.mark:after{content:'';position:absolute;width:24px;border-top:1px solid #C9823D;top:10px;left:0}.navitems{display:flex;gap:30px;height:100%;align-items:center}.navitem{height:100%;display:flex;align-items:center;color:#AAB5C3;font-size:14px;position:relative}.navitem.active{color:#F3F0EA}.navitem.active:after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:#8DA4C7}.navright{margin-left:auto;color:#AAB5C3;font-size:14px;display:flex;gap:25px;align-items:center}.themeicon{width:16px;height:16px;border:1.5px solid #AAB5C3;border-radius:50%;position:relative}.themeicon:after{content:'';position:absolute;background:#0A0D12;width:12px;height:12px;top:-4px;right:-4px;border-radius:50%}.filebar{height:98px;display:flex;align-items:center;justify-content:space-between;padding:0 48px}.fileinfo{display:flex;align-items:center;gap:24px}.fileinfo h1{font-size:23px;line-height:1.3;margin:0;font-weight:700;letter-spacing:-.3px}.fileinfo .detail{border-left:1px solid #343C46;padding-left:24px;color:#B6C0CC;font-size:14px}.fileinfo .date{color:#929EAE;margin-left:15px}.actions{display:flex;gap:10px}.button{height:38px;border:1px solid #485568;border-radius:6px;background:transparent;color:#E2E8EF;padding:0 17px;display:flex;align-items:center;gap:8px;font-size:14px}.button svg{width:15px;height:15px;stroke:currentColor;stroke-width:1.6;fill:none;stroke-linecap:round;stroke-linejoin:round}.button.primary{background:#5D7396;color:#fff;border-color:#5D7396}.sequence{height:198px;background:#141922;border-block:1px solid #29313B;padding:15px 48px 0;position:relative}.sequence-top{display:flex;justify-content:space-between;align-items:center;height:25px;font-size:13px;color:#A9B4C2}.sequence-top strong{font-size:14px;color:#D8E0EB;font-weight:400}.sequence-top .num{font-variant-numeric:tabular-nums;letter-spacing:.4px}.frames{height:146px;display:grid;grid-template-columns:repeat(5,1fr);gap:0}.frame{height:146px;display:flex;align-items:center;flex-direction:column;position:relative;padding-top:10px}.frame:after{content:'';height:1px;background:#38414E;position:absolute;left:0;right:0;bottom:15px}.thumb{width:71px;height:98px;display:block;object-fit:cover;object-position:50% 45%;opacity:.64;border-radius:2px;filter:saturate(.65)}.frame.selected .thumb{opacity:1;filter:none;outline:2px solid #C9823D;outline-offset:3px}.time{position:absolute;bottom:-7px;font-size:13px;color:#99A6B6;z-index:2;background:#141922;padding:0 9px;font-variant-numeric:tabular-nums}.frame.selected .time{color:#E1A86F}.tick{position:absolute;width:5px;height:5px;bottom:13px;background:#6F7D90;transform:rotate(45deg);z-index:2}.frame.selected .tick{width:7px;height:7px;bottom:12px;background:#C9823D}.analysis{height:480px;position:relative;display:grid;grid-template-columns:1fr 392px 1fr;gap:52px;padding:24px 104px 0}.measurements{padding-top:27px;max-width:284px}.current{font-size:13px;color:#B6C0CC;display:flex;align-items:center;gap:8px}.current i{display:block;width:6px;height:6px;border-radius:50%;background:#C9823D}.bigtime{font-family:Harmony,sans-serif;font-variant-numeric:tabular-nums;font-size:60px;line-height:1.2;letter-spacing:-2.5px;margin:9px 0 27px;font-weight:400}.bigtime small{font-size:17px;color:#9AA8B9;letter-spacing:0;margin-left:10px}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:20px;border-top:1px solid #343C46;padding-top:20px}.metric .label{font-size:14px;color:#B6C0CC;margin-bottom:3px}.metric .value{font-size:33px;line-height:1.3;font-variant-numeric:tabular-nums;letter-spacing:-1px}.metric .range{color:#8F9DAC;font-size:13px;margin-top:6px}.metric.caution .value{color:#E1A86F}.unreliable{margin-top:24px;padding-top:18px;border-top:1px solid #343C46;color:#AEB9C7;font-size:14px;line-height:1.65;display:flex;align-items:flex-start;gap:9px}.unreliable svg{width:16px;height:16px;min-width:16px;margin-top:3px;fill:none;stroke:#AEB9C7;stroke-width:1.5}.mainframe{margin:0;height:433px;position:relative;display:flex;align-items:center;justify-content:center}.mainframe:before,.mainframe:after{content:'';position:absolute;width:17px;height:17px;border-color:#576474;border-style:solid;z-index:1}.mainframe:before{left:0;top:0;border-width:1px 0 0 1px}.mainframe:after{right:0;bottom:0;border-width:0 1px 1px 0}.mainframe img{width:280px;height:433px;object-fit:cover;object-position:center}.image-label{position:absolute;bottom:10px;left:68px;background:rgba(10,13,18,.87);color:#ECE9E3;padding:3px 8px;font-size:12px;letter-spacing:.2px}.insight{padding-top:27px;max-width:290px}.insight .section{color:#AEB9C7;font-size:13px;margin:0 0 10px}.insight h2{font-size:27px;line-height:1.45;letter-spacing:-.5px;font-weight:700;margin:0 0 16px;max-width:270px}.insight .description{color:#B6C0CC;line-height:1.8;font-size:15px;margin:0 0 20px}.confidence{display:flex;align-items:center;gap:13px;font-size:13px;color:#AEB9C7}.confidence .track{width:86px;height:3px;background:#3A424D}.confidence .fill{height:3px;width:71%;background:#C9823D}.confidence strong{color:#E1A86F;font-size:16px;font-weight:400;font-variant-numeric:tabular-nums}.next{margin-top:29px;border-top:1px solid #343C46;padding-top:18px}.next h3{font-size:14px;font-weight:400;margin:0 0 8px;color:#E3E8EF}.next p{text-wrap:balance;font-size:14px;color:#B6C0CC;line-height:1.8;margin:0}.bottom{height:60px;margin:0 48px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid #29313B;color:#A7B3C2;font-size:13px}.bottom .note{display:flex;gap:14px}.bottom .note span:first-child{color:#D7DFEA}.bottom .key{border:1px solid #435063;padding:1px 6px;border-radius:3px;color:#D5DDEA;margin:0 5px}.bottom .frameid{font-variant-numeric:tabular-nums;color:#C3CDD9;letter-spacing:.3px}
</style>
</head>
<body><div class="shell">
<header class="topnav">
  <div class="wordmark"><span class="mark"></span>ShotForm</div>
  <nav class="navitems" aria-label="主导航"><span class="navitem">首页</span><span class="navitem">上传素材</span><span class="navitem active">动作分析</span><span class="navitem">训练历史</span><span class="navitem">球星对比</span></nav>
  <div class="navright"><span>模板管理</span><span>设置</span><span class="themeicon" aria-hidden="true"></span></div>
</header>
<header class="filebar">
  <div class="fileinfo"><h1>{{TITLE}}</h1><div class="detail">{{FILE}}<span class="date">{{DATE}}</span></div></div>
  <div class="actions"><button class="button"><svg viewBox="0 0 24 24"><path d="M12 3v12m-4-4 4 4 4-4M5 15v5h14v-5"/></svg>{{EXPORT}}</button><button class="button primary"><svg viewBox="0 0 24 24"><path d="M5 3h14v18l-7-4-7 4Z"/></svg>{{SAVE}}</button></div>
</header>
<section class="sequence" aria-label="视频关键帧序列">
  <div class="sequence-top"><strong>动作序列</strong><span class="num">5 个关键帧 · {{DURATION}}</span></div>
  <div class="frames">
    <div class="frame"><img class="thumb" src="assets/frame-1.jpg" alt="第一个关键帧"><span class="tick"></span><span class="time">00:00.25</span></div>
    <div class="frame"><img class="thumb" src="assets/frame-2.jpg" alt="第二个关键帧"><span class="tick"></span><span class="time">00:00.75</span></div>
    <div class="frame selected"><img class="thumb" src="assets/frame-3.jpg" alt="当前选中的第三个关键帧"><span class="tick"></span><span class="time">{{TIME}}</span></div>
    <div class="frame"><img class="thumb" src="assets/frame-4.jpg" alt="第四个关键帧"><span class="tick"></span><span class="time">00:01.75</span></div>
    <div class="frame"><img class="thumb" src="assets/frame-5.jpg" alt="第五个关键帧"><span class="tick"></span><span class="time">00:02.25</span></div>
  </div>
</section>
<main class="analysis">
  <section class="measurements">
    <div class="current"><i></i>当前帧 · 角度观察</div>
    <div class="bigtime">01.25<small>秒</small></div>
    <div class="metrics">
      <div class="metric"><div class="label">右肘角度</div><div class="value">{{ELBOW}}</div><div class="range">参考 80–110°</div></div>
      <div class="metric caution"><div class="label">左膝角度</div><div class="value">{{KNEE}}</div><div class="range">参考 140–170°</div></div>
    </div>
    <div class="unreliable"><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/><path d="M10 5.5v5m0 2v1.5"/></svg><span>{{CAUTION}}</span></div>
  </section>
  <figure class="mainframe"><img src="assets/frame-3.jpg" alt="当前投篮动作关键帧"><figcaption class="image-label">{{TIME}} · 第 3 帧</figcaption></figure>
  <section class="insight">
    <p class="section">{{SHOT}}</p><h2>{{CONCLUSION}}</h2>
    <p class="description">{{REASON}}</p>
    <div class="confidence"><span>分型置信度</span><span class="track"><span class="fill" style="display:block"></span></span><strong>{{CONFIDENCE}}</strong></div>
    <div class="next"><h3>下一次训练</h3><p>{{NEXT}}</p></div>
  </section>
</main>
<footer class="bottom"><div class="note"><span>训练备注</span><span>{{NOTE}}</span></div><div class="frameid">当前帧 03 / 05</div></footer>
</div></body></html>
